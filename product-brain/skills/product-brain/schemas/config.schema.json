{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ProductBrainConfig",
  "description": "Schema for the orchestrator config.yaml.",
  "type": "object",
  "required": ["repos", "pm_adapter", "llm"],
  "additionalProperties": false,
  "properties": {
    "repos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "path"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string", "description": "Path resolved relative to config.yaml's directory." }
        }
      }
    },
    "ticket_regex": { "type": "string", "default": "AHA-\\d+" },
    "pm_adapter": { "type": "string", "enum": ["aha", "linear", "jira"] },
    "test_adapter": {
      "type": ["string", "null"],
      "enum": ["testrail", "zephyr", "xray", null],
      "description": "Optional. If set, ticket records gain test_cases, qa_edges, stability_signals, coverage_gaps."
    },
    "aha": {
      "type": "object",
      "required": ["subdomain", "api_key_env"],
      "properties": {
        "subdomain": { "type": "string" },
        "api_key_env": { "type": "string" },
        "workspace": { "type": "string" }
      }
    },
    "testrail": {
      "type": "object",
      "properties": {
        "base_url": { "type": "string", "description": "https://yourco.testrail.io" },
        "user_email": { "type": "string" },
        "api_key_env": { "type": "string" },
        "project_id": { "type": "integer" },
        "refs_field": { "type": "string", "description": "Custom field on cases that holds ticket IDs (default: refs)" },
        "run_history_window_days": { "type": "integer", "minimum": 1 }
      }
    },
    "github": {
      "type": "object",
      "properties": { "api_key_env": { "type": "string" } }
    },
    "llm": {
      "type": "object",
      "required": ["provider", "api_key_env"],
      "properties": {
        "provider": { "type": "string", "enum": ["anthropic"] },
        "api_key_env": { "type": "string" },
        "model_summarize": { "type": "string" },
        "model_extract": { "type": "string" },
        "model_synthesize": { "type": "string" },
        "max_input_tokens_per_ticket": { "type": "integer", "minimum": 1000 }
      }
    },
    "estimate": {
      "type": "object",
      "properties": {
        "unit": { "type": "string", "enum": ["days", "points"] },
        "reference_window_days": { "type": "integer", "minimum": 1 },
        "min_similarity": { "type": "number", "minimum": 0, "maximum": 1 },
        "min_references_for_medium": { "type": "integer", "minimum": 1 },
        "min_references_for_high": { "type": "integer", "minimum": 1 }
      }
    },
    "backfill": {
      "type": "object",
      "properties": {
        "workflow": { "type": "string", "enum": ["squash", "merge", "rebase"] },
        "pr_enrichment": { "type": "boolean" },
        "symbol_extraction": { "type": "boolean" }
      }
    },
    "bot": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string" },
        "port": { "type": "integer" },
        "webhook_signing_secret_env": { "type": "string" },
        "allowed_users": { "type": "array", "items": { "type": "string" } },
        "cooldown_hours": { "type": "integer", "minimum": 0 },
        "opt_in_label": { "type": "string" },
        "kill_switch_label": { "type": "string" },
        "quiet_hours_utc": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 23 },
          "minItems": 2,
          "maxItems": 2
        },
        "draft_status": { "type": "string" }
      }
    },
    "audit": {
      "type": "object",
      "properties": { "path": { "type": "string" } }
    },
    "queue": {
      "type": "object",
      "properties": {
        "backend": { "type": "string", "enum": ["sqlite", "redis"] },
        "path": { "type": "string" }
      }
    }
  }
}
