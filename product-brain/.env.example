# Copy to .env and fill in. Loaded by CLI and bot.

# Anthropic API key for LLM calls (backfill summarization, edge-case extraction, groom synthesis).
ANTHROPIC_API_KEY=

# Aha API token. Generate at https://<subdomain>.aha.io/settings/api_keys
AHA_API_KEY=

# Aha webhook signing secret. Set in Aha's webhook config and copied here.
# Only used by the bot's webhook endpoint.
AHA_WEBHOOK_SECRET=

# GitHub token for PR enrichment. Needs read access to all configured repos.
GITHUB_TOKEN=

# TestRail API key (optional). Only needed if test_adapter: testrail.
# Generate at https://<subdomain>.testrail.io/index.php?/mysettings
TESTRAIL_API_KEY=

# Optional. HMAC secret for /webhook/source-merge requests from source repos.
# Set the same value in source repos' GitHub Actions secrets or post-merge env.
PRODUCT_BRAIN_SOURCE_MERGE_SECRET=
