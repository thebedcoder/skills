.DS_Store
node_modules/

# graphify — keep reports, ignore cache + local-path bookkeeping
*/graphify-out/manifest.json
*/graphify-out/cost.json
*/graphify-out/cache/
*/graphify-out/.graphify_python
*/graphify-out/.graphify_root

# Claude Code — per-user, never committed
.claude/settings.local.json
**/.claude/settings.local.json

# .skill zips are build output for the claude.ai packager — rebuild at release
# time with /rebuild-artifacts. Committed copies drift silently: git reports the
# repo clean while the archive falls months behind source.
*.skill

# graphify knowledge-graph build output
graphify-out/
