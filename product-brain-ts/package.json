{
  "name": "product-brain",
  "version": "0.1.0-ts.0",
  "description": "Cross-repo memory + planning over a ticket-keyed code index. TypeScript port of the Python implementation.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.18.0"
  },
  "bin": {
    "product-brain": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "audit": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.91.1",
    "better-sqlite3": "12.9.0",
    "commander": "14.0.3",
    "dotenv": "17.4.2",
    "fastify": "5.8.5",
    "js-yaml": "4.1.1",
    "openai": "6.34.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "simple-git": "3.36.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/js-yaml": "4.0.9",
    "@types/node": "25.6.0",
    "@typescript-eslint/eslint-plugin": "8.59.0",
    "@typescript-eslint/parser": "8.59.0",
    "eslint": "10.2.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  }
}
